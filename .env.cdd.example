# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONCEPT_DRIFT_TRIGGER_TOPIC=concept-drift-trigger-events-docker-test
KAFKA_CONCEPT_DRIFT_COMPLETE_TOPIC=concept-drift-complete-events-docker-test
KAFKA_CONCEPT_DRIFT_CONSUMER_GROUP=concept-drift-consumer-docker-e2e
CONCEPT_DRIFT_WORKER_ID=cdd-docker-1

# Data Warehouse
API_BASE=http://data-warehouse-api:8000

# AutoML HTTP service
AUTOML_ENGINE_HOST=alfie_automl_engine
AUTOML_ENGINE_PORT=8001

# AutoML Python compatibility source inside this container
AUTOML_ENGINE_REPO=/opt/alfie_automl_engine

# Vision
VISION_RETRAIN_TIME_BUDGET_SECONDS=60
VISION_RETRAIN_READ_TIMEOUT_SECONDS=21600
VISION_MIN_ACCURACY_IMPROVEMENT=0.01
VISION_MIN_F1_IMPROVEMENT=0.01
VISION_MIN_HOLDOUT_IMAGES=20
VISION_ADWIN_DELTA=0.002

# Segmentation
SEGMENTATION_IGNORE_BACKGROUND=false
SEGMENTATION_MIN_MIOU_IMPROVEMENT=0.01
SEGMENTATION_MIN_DICE_IMPROVEMENT=0.01
